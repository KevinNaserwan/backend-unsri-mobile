    {
      "name": "6. Performance & Monitoring",
      "item": [
        {
          "name": "Rate Limit Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response received (may be rate limited)\", function () {",
                  "    // Should receive either 200 or 429 (Too Many Requests)",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 429]);",
                  "});",
                  "",
                  "if (pm.response.code === 429) {",
                  "    pm.test(\"Rate limit response format\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData).to.have.property('success');",
                  "        pm.expect(jsonData.success).to.be.false;",
                  "        pm.expect(jsonData.error).to.include('Too many requests');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "CORS Headers Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"CORS headers present\", function () {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('*');",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('GET');",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:3000"
              },
